# FraudX configuration. Copy to .env (`make env`) and change every password.
# The same file feeds docker compose (variable interpolation) and services run
# on the host (`uv run ...`). Host values below point at localhost; compose
# overrides hostnames for containers.
#
# Host ports: every `*_PORT` below is also the port compose publishes on
# 127.0.0.1, so change it in one place when a port is taken (for example
# MONGO_PORT=27018 next to a system MongoDB). Containers always talk to each
# other on the internal network with the default ports.

# --- Application --------------------------------------------------------------
FRAUDX_ENV=local
FRAUDX_LOG_LEVEL=INFO
# json | text
FRAUDX_LOG_FORMAT=json
FRAUDX_RISK_CONFIG_PATH=config/risk.yaml
FRAUDX_DEPENDENCY_TIMEOUT_S=3
API_PORT=8000
DASHBOARD_PORT=8090

# --- Kafka (KRaft, single broker) ---------------------------------------------
# Host clients use KAFKA_BOOTSTRAP_SERVERS; keep its port equal to KAFKA_PORT.
KAFKA_PORT=9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_UI_PORT=8080
KAFKA_CLIENT_ID=fraudx
# KRaft cluster id (base64 UUID). Generate a new one with:
#   docker run --rm apache/kafka:4.1.0 /opt/kafka/bin/kafka-storage.sh random-uuid
KAFKA_CLUSTER_ID=4L6g3nShT-eMCtK--X86sw
KAFKA_TOPIC_PARTITIONS=6

# --- MongoDB ------------------------------------------------------------------
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=fraudx
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=change-me-mongo-root
MONGO_APP_USER=fraudx_app
MONGO_APP_PASSWORD=change-me-mongo-app

# --- Cassandra ----------------------------------------------------------------
CASSANDRA_CONTACT_POINTS=localhost
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=fraudx
CASSANDRA_LOCAL_DC=datacenter1

# --- Redis --------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=change-me-redis
# Disposable Redis for offline feature builds (`make offline-redis`).
REDIS_OFFLINE_PORT=6380

# --- Neo4j (password: 8+ characters) ------------------------------------------
# Host clients use NEO4J_URI; keep its port equal to NEO4J_BOLT_PORT.
NEO4J_BOLT_PORT=7687
NEO4J_HTTP_PORT=7474
NEO4J_URI=bolt://localhost:7687
# Disposable Neo4j for offline graph-feature builds (`make offline-neo4j`).
NEO4J_OFFLINE_BOLT_PORT=7688
NEO4J_OFFLINE_URI=bolt://localhost:7688
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-neo4j

# --- Observability ------------------------------------------------------------
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana

# --- Alert explanations (Phase 9) -----------------------------------------------
# `template` produces deterministic, evidence-only explanations offline.
# `anthropic` sends pseudonymised evidence to Claude (falls back to the template
# on any failure) and needs ANTHROPIC_API_KEY.
EXPLAIN_PROVIDER=template
EXPLAIN_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=
# Optional: POST a JSON summary of each new investigation (Slack/Teams/... webhook).
ALERTS_WEBHOOK_URL=
